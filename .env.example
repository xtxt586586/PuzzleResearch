# ========== Application ==========

APP_NAME=PuzzleResearch
APP_ENV=dev
DEBUG=true
HOST=127.0.0.1
PORT=8001

# ========== DeepSeek ==========

DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

PRIMARY_MODEL=deepseek-chat
REASONING_MODEL=deepseek-reasoner
MODEL_TIMEOUT=60

# ========== Search Providers ==========

TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

SEARCH_ENGINES=tavily,duckduckgo

WEB_MAX_QUERIES=3
WEB_RESULTS_PER_QUERY=5

# ========== Message Context ==========

TRIM_MESSAGES=true
TRIM_MESSAGES_KEEP_FIRST=1
TRIM_MESSAGES_KEEP_LAST=8
SUMMARY_MESSAGES=false
SUMMARY_MESSAGES_TRIGGER=20

# ========== Database ==========

DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# ========== RAG ==========

RAG_ENABLED=false
RAG_STORE_PATH=./data/chroma
RAG_COLLECTION_NAME=puzzleresearch_documents
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# ========== Agent Safety ==========

TOOL_APPROVAL=false
HUMAN_REVIEW=false
MAX_REVISIONS=2
TOOL_CALL_LIMIT=20

# ========== Deep Research ==========

DEEPSEARCH_MODE=auto
DEEPSEARCH_MAX_EPOCHS=3
DEEPSEARCH_QUERY_NUM=5
DEEPSEARCH_RESULTS_PER_QUERY=5
DEEPSEARCH_MAX_SECONDS=0
DEEPSEARCH_MAX_TOKENS=0
